DATABASE_URL="file:./dev.db"
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
SCAN_WORKDIR=workdir
# BullMQ's job queue - run `docker compose up -d redis` from the repo root for local dev
REDIS_URL=redis://localhost:6379
# Must be 32+ random characters, e.g. generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-random-characters
